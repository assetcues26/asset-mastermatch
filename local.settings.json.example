    "PINECONE_INDEX_NAME": "<your-pinecone-index>",
    "PINECONE_TOP_K": "5",
    "PINECONE_CALL_TIMEOUT_SEC": "10",

    "BATCH_DEADLINE_SEC": "90",

    "MAX_ASSETS_PER_REQUEST": "50",
    "MAX_PARALLEL_ITEMS": "10",
    "MAX_ASSET_NAME_LENGTH": "800",
    "MAX_ASSET_DESCRIPTION_LENGTH": "800",
    "MAX_EMBED_QUERY_LENGTH": "1000",
